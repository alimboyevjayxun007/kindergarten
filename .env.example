# Django
DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC

# Render/self ping
# Example: https://your-service.onrender.com/healthz/
SELF_PING_ENABLED=0
SELF_PING_URL=
SELF_PING_INTERVAL_SECONDS=600

# Database
# Default behavior: if DATABASE_URL is not set, SQLite (db.sqlite3) is used.
#
# SQLite example:
# DATABASE_URL=sqlite:///./db.sqlite3
#
# PostgreSQL example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kindergarten_crm
